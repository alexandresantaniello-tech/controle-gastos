{
  "name": "Clara — Controle da sua Renda",
  "short_name": "Clara",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#000919",
  "theme_color": "#000919",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "receipt", "accept": ["image/png", "image/jpeg", "image/webp", "application/pdf", ".png", ".jpg", ".jpeg", ".webp", ".pdf"] }
      ]
    }
  }
}
